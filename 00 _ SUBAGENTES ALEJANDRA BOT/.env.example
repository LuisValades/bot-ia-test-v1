# ============================================================
# .env.example — SUBAGENTES ALEJANDRA (n8n + VPS Hostinger)
# ============================================================
# Copia este archivo a `.env` y rellena los valores reales.
# .env NO se commitea (esta en .gitignore).
# ============================================================

# ----------------------------------------------------------------
# VPS HOSTINGER
# ----------------------------------------------------------------
HOSTINGER_VPS_IP=
HOSTINGER_VPS_USER=root
HOSTINGER_VPS_PORT=22
HOSTINGER_VPS_HOSTNAME=
# Ruta local del archivo de clave SSH privada (no la pegues, solo la ruta)
HOSTINGER_SSH_KEY_PATH=

# ----------------------------------------------------------------
# N8N (auto-hospedado en VPS)
# ----------------------------------------------------------------
N8N_HOST=
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_WEBHOOK_URL=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=

# ----------------------------------------------------------------
# OPENROUTER (modelos LLM por subagente)
# ----------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ROUTER=anthropic/claude-haiku-4-5
OPENROUTER_MODEL_GREETER=anthropic/claude-haiku-4-5
OPENROUTER_MODEL_HIPOTECA=anthropic/claude-haiku-4-5
OPENROUTER_MODEL_PYME=anthropic/claude-haiku-4-5
OPENROUTER_MODEL_CLOSER=anthropic/claude-haiku-4-5
OPENROUTER_MODEL_OBJECTION=anthropic/claude-sonnet-4-5
OPENROUTER_MODEL_MULTIMODAL=anthropic/claude-haiku-4-5
OPENROUTER_MODEL_FOLLOWUP=anthropic/claude-haiku-4-5

# ----------------------------------------------------------------
# PINECONE (vector store por namespace)
# ----------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_INDEX_NAME=crediexpres-kb
PINECONE_NAMESPACE_HIPOTECA=knowledge-hipoteca
PINECONE_NAMESPACE_PYME=knowledge-pyme
PINECONE_NAMESPACE_OBJECTIONS=objections

# ----------------------------------------------------------------
# SUPABASE (memoria persistente — tabla `leads`)
# ----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ----------------------------------------------------------------
# GOHIGHLEVEL (CRM)
# ----------------------------------------------------------------
GHL_TOKEN=
GHL_LOCATION_ID=
GHL_BASE_URL=https://services.leadconnectorhq.com

# ----------------------------------------------------------------
# GMAIL (notificaciones a asesores)
# ----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_USER=
NOTIFICATION_FROM=

# ----------------------------------------------------------------
# ASESORES (mismo JSON que en bot-alejandra-env de Modal)
# ----------------------------------------------------------------
ASESORES_JSON={}
